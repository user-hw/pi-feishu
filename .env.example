# ── 必填：飞书自建应用凭据 ────────────────────────────────────────────
# 开发者后台 → 你的应用 → 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 安全策略（重要，先读完再改）───────────────────────────────────────
# 私聊策略：allowlist | pair | open | disabled
#   allowlist  只允许 PI_FEISHU_DM_ALLOWLIST 里的 open_id（推荐）
#   pair       未知发送者拿到配对码，你在日志里放行
#   open       任何人私聊都能驱动你电脑上的 agent —— 危险，别用
PI_FEISHU_DM_MODE=allowlist

# 允许私聊的 open_id，逗号分隔。第一次启动时在群里发 /whoami 就能拿到自己的 open_id
PI_FEISHU_DM_ALLOWLIST=

# 允许的群 chat_id（oc_ 开头），逗号分隔。留空=不允许任何群
PI_FEISHU_GROUP_ALLOWLIST=

# 群里是否需要 @机器人 才响应（默认需要）
PI_FEISHU_REQUIRE_MENTION=1

# ── 入站方式 ──────────────────────────────────────────────────────
# poll   = 每 N 毫秒调用 im.v1.message.list 拉取新消息（默认，不依赖事件推送）
# events = 用飞书事件推送（需要后台配置「使用长连接接收事件」）
PI_FEISHU_TRANSPORT=poll
PI_FEISHU_POLL_MS=3000

# 额外要监控的会话 ID（oc_ 开头），逗号分隔。
# 群聊一般不用填：留空时会自动监控机器人所在的所有群。
# 私聊必须填 —— 因为飞书不提供「列出私聊会话」的接口。
PI_FEISHU_CHAT_IDS=

# ── agent 运行环境 ────────────────────────────────────────────────────
# agent 的工作目录。默认 ~/pi-feishu/workspace
# 不建议指向 $HOME 根目录：agent 有完整 shell 权限
PI_FEISHU_CWD=

# 可选：覆盖模型，如 deepseek/deepseek-chat、anthropic/claude-sonnet-4-6
PI_FEISHU_MODEL=
# 可选：思考等级 off | minimal | low | medium | high | xhigh | max
PI_FEISHU_THINKING=

# 会话空闲多久回收 pi 子进程（毫秒），默认 15 分钟
PI_FEISHU_IDLE_MS=900000

# 单轮最长运行时间（毫秒），默认 30 分钟，超时自动中止
PI_FEISHU_MAX_TURN_MS=1800000

# 启动时往已监控的会话发一条上线通知（1=开，0=关）
PI_FEISHU_NOTIFY_ON_START=1
